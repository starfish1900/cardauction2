{
  "name": "@cardauction/server",
  "version": "0.1.0",
  "private": true,
  "description": "CardAuction game server: sessions, lobby, games, timers and disconnects over Socket.IO.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@cardauction/ai": "workspace:*",
    "@cardauction/engine": "workspace:*",
    "@cardauction/protocol": "workspace:*",
    "express": "^5.2.1",
    "obscenity": "^0.4.6",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
