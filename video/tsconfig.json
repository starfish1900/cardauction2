{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "types": [],
    "paths": {
      "@cardauction/engine": ["../packages/engine/src/index.ts"]
    }
  },
  "include": ["src", "remotion.config.ts"]
}
